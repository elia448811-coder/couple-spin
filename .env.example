# נתיב בסיס לאפליקציה (GitHub Pages: /double-game/ · Vercel: /)
VITE_BASE_PATH=/

# ── שער סיסמה (מאובטח) ──
# הסיסמה לא נכנסת לקוד האתר — רק למשתני סביבה בשרת.

# אפשרות א' — Vercel (מומלץ):
#   VITE_SITE_GATE=true
#   וב-Vercel Dashboard / CLI:
#     SITE_PASSWORD=your-secret-password
#     SESSION_SECRET=random-long-secret (required in production; separate from password)
#     CURRENT_KID=v2
#     SESSION_SECRETS={"v1":"old-secret","v2":"random-long-secret"}  # optional verification key rotation
#     ALLOW_LEGACY_TOKENS=false
#     ALLOWED_ORIGINS=https://couple-spin.vercel.app,https://double-game-black.vercel.app
#     CORS_METHODS=GET,POST,OPTIONS
#     UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
#     UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
VITE_SITE_GATE=

# אפשרות ב' — Cloudflare Worker חיצוני:
#   VITE_AUTH_API_URL=https://couple-spin-auth.xxx.workers.dev
VITE_AUTH_API_URL=

# Cloudflare Worker bindings use PASS_W for the gate password plus SESSION_SECRET for signing.
# REQUIRE_SESSION_SECRET=true
# CURRENT_KID=v2
# SESSION_SECRETS=v1:old-secret,v2:random-long-secret
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Firebase / Firestore (cloud backup sync) ──
# Enable Authentication → Anonymous and create a Firestore database, then paste Web App config:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Deploy Firestore rules (after: npx firebase-tools login):
#   npm run deploy:firestore
# Verify rooms: npm run check:firestore-rooms

