{
  "name": "couple-spin",
  "private": true,
  "version": "1.1.0",
  "description": "ספין זוגי — משחק משימות ושאלות לזוגות (Couple Spin)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:system": "node scripts/test-system.mjs",
    "test:layouts": "node scripts/test-device-layouts.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:build": "node scripts/build-production.mjs",
    "deploy:preview": "npm run deploy:build && vite preview --host",
    "generate:questions": "node scripts/generate-from-experience.mjs",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:firebase": "node scripts/check-firebase.mjs",
    "check:firestore-rooms": "node scripts/check-firestore-rooms.mjs",
    "check:user-profile": "node scripts/check-user-profile.mjs",
    "check:email-auth": "node scripts/check-email-auth.mjs",
    "ensure:test-users": "node scripts/ensure-test-users.mjs",
    "seed:admin": "node scripts/seed-admin-config.mjs",
    "ensure:sole-admin": "node scripts/ensure-sole-admin.mjs",
    "set:admin-password": "node scripts/set-admin-password.mjs",
    "send:admin-reset": "node scripts/send-admin-reset-email.mjs",
    "export:questions": "node scripts/export-questions.mjs",
    "deploy:firestore": "node scripts/deploy-firestore.mjs",
    "prebuild": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
